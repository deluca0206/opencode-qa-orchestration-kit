{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "qa-lead",
  "agents": {
    "qa-lead": {
      "description": "Orchestrates QA investigation and coverage; consolidates evidence without editing or executing.",
      "mode": "primary",
      "system": "{file:./agents/qa-lead.md}",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "playwright-cli-nav",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "bug-code-correlation",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "playwright-e2e-suite",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "api-contract-testing",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "qa-test-design",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "qa-browser-explorer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "qa-bug-tracer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "qa-e2e-engineer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "qa-quality-auditor",
          "effect": "allow"
        },
        {
          "action": "*",
          "resource": "**/.env",
          "effect": "deny"
        },
        {
          "action": "*",
          "resource": "**/.env.*",
          "effect": "deny"
        },
        {
          "action": "*",
          "resource": "**/secrets/**",
          "effect": "deny"
        },
        {
          "action": "*",
          "resource": "**/credentials/**",
          "effect": "deny"
        },
        {
          "action": "*",
          "resource": "**/*.pem",
          "effect": "deny"
        },
        {
          "action": "*",
