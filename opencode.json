          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*<*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*#*",
          "effect": "deny"
        },
        {
          "action": "*",
          "resource": "**/.env",
          "effect": "deny"
