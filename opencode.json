        {
          "action": "*",
          "resource": "**/id_rsa*",
          "effect": "deny"
        },
        {
          "action": "*",
          "resource": "**/id_ed25519*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "qa-browser-explorer": {
      "description": "Reproduces authorized flows using the existing playwright-cli, snapshots and refs, without a custom MCP or runner.",
      "mode": "subagent",
      "system": "{file:./agents/qa-browser-explorer.md}",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "playwright-cli-nav",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --json -s=qa-kit-???????? open --idle-timeout=60000 -- *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --json -s=qa-kit-???????? goto -- *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --json -s=qa-kit-???????? snapshot --",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --json -s=qa-kit-???????? click -- *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --json -s=qa-kit-???????? fill -- *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --json -s=qa-kit-???????? screenshot --",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --json -s=qa-kit-???????? console --",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --json -s=qa-kit-???????? requests --",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --json -s=qa-kit-???????? close --",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --version",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "NO_UPDATE_NOTIFIER=1 playwright-cli --help",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*;*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*&*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*|*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*`*",
          "effect": "deny"
        },
        {
