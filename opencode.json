          "resource": "**/.env.*",
          "effect": "deny"
        },
        {
          "action": "*",
          "resource": "**/secrets/**",
          "effect": "deny"
        },
        {
          "action": "*",
          "resource": "**/credentials/**",
          "effect": "deny"
        },
        {
          "action": "*",
